                {
                  "slug": "title",
                  "name": "عنوان",
                  "field_type": "text",
                  "order": 0,
                  "values": {
                    "fa": "آیا به حساب بانکی من وصل می‌شود؟",
                    "en": "Does it connect to my bank account?"
                  }
                },
                {
                  "slug": "body",
                  "name": "متن",
                  "field_type": "textarea",
                  "order": 1,
                  "values": {
                    "fa": "نه. Summa رمز و اطلاعات بانکی نمی‌گیرد؛ فقط متنی را که خودت می‌فرستی می‌خواند.",
                    "en": "No. Summa never asks for banking credentials. It only reads the text you choose to send it."
                  }
                }
              ]
            },
            {
              "slug": "q2",
              "name": "سؤال 2",
              "order": 1,
              "fields": [
                {
                  "slug": "title",
                  "name": "عنوان",
                  "field_type": "text",
                  "order": 0,
                  "values": {
                    "fa": "خودش بدون اجازه من چیزی ثبت می‌کند؟",
                    "en": "Will it record things without asking?"
                  }
                },
                {
                  "slug": "body",
                  "name": "متن",
                  "field_type": "textarea",
                  "order": 1,
                  "values": {
                    "fa": "نه. هر پیشنهاد یک کارت است و ثبت فقط با زدن «ثبت» توسط خودت انجام می‌شود.",
                    "en": "No. Every suggestion is a card, and nothing is written until you tap Register."
                  }
                }
              ]
            },
            {
              "slug": "q3",
              "name": "سؤال 3",
              "order": 2,
              "fields": [
                {
                  "slug": "title",
                  "name": "عنوان",
                  "field_type": "text",
                  "order": 0,
                  "values": {
                    "fa": "قیمت‌ها دقیق‌اند؟",
                    "en": "Are the prices exact?"
                  }
                },
                {
                  "slug": "body",
                  "name": "متن",
                  "field_type": "textarea",
                  "order": 1,
                  "values": {
                    "fa": "نه، تقریبی‌اند. Summa صرافی نیست و توصیه خرید و فروش نمی‌دهد.",
                    "en": "No, they are approximate. Summa is not an exchange and gives no buy or sell advice."
                  }
                }
              ]
            },
            {
              "slug": "q4",
              "name": "سؤال 4",
              "order": 3,
              "fields": [
                {
                  "slug": "title",
                  "name": "عنوان",
                  "field_type": "text",
                  "order": 0,
                  "values": {
                    "fa": "با تغییر گوشی داده‌ام می‌ماند؟",
                    "en": "Do I keep my data on a new phone?"
                  }
                },
                {
                  "slug": "body",
                  "name": "متن",
                  "field_type": "textarea",
                  "order": 1,
                  "values": {
                    "fa": "بله. داده روی سرور نگه‌داری می‌شود و با ورود دوباره برمی‌گردد.",
                    "en": "Yes. Your data is kept on the server and comes back when you sign in again."
                  }
                }
              ]
            }
          ]
        }
